// AgentBeats registration manifest for LucidCoder
// See: https://docs.agentbeats.dev/manifest/
{
  manifest_version: "0.1.0",

  metadata: {
    name: "LucidCoder",
    description: "Self-disciplined coding agent for Terminal-Bench 2.0. Decompose -> plan (with checker) -> execute (with retry + anti-paralysis guard) -> verify (test run + anti-pattern grep + artifact check). Speaks terminal-bench-shell-v1 over A2A.",
  },

  // Vertex AI authentication: a single secret holds the JSON-encoded
  // service-account key. The container writes it to disk on startup and points
  // GOOGLE_APPLICATION_CREDENTIALS at the file. Project/location are static.
  config_schema: {
    type: "object",
    properties: {
      google_application_credentials_json: {
        type: "string",
        secret: true,
        description: "JSON-encoded service-account key with Vertex AI User role",
      },
      google_cloud_project: {
        type: "string",
        secret: false,
        description: "GCP project ID (e.g. 'my-project-123')",
      },
      google_cloud_location: {
        type: "string",
        secret: false,
        description: "Vertex AI region (default: 'global')",
      },
    },
    required: ["google_application_credentials_json", "google_cloud_project"],
    additionalProperties: false,
  },

  program: {
    image: "ghcr.io/mdadopoulos/lucidcoder:latest",
    entrypoint: ["/home/agent/workspace/entrypoint.sh"],
    env: {
      // Vertex AI credentials. The entrypoint writes the JSON to /tmp/sa.json
      // and exports GOOGLE_APPLICATION_CREDENTIALS for google-genai's ADC chain.
      GOOGLE_APPLICATION_CREDENTIALS_JSON: "${config.google_application_credentials_json}",
      GOOGLE_CLOUD_PROJECT:                "${config.google_cloud_project}",
      GOOGLE_CLOUD_LOCATION:               "${config.google_cloud_location}",

      // Static configuration
      MODEL_ID: "gemini-3.1-pro-preview",
      LOG_LEVEL: "INFO",
    },
    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9009 },
      ],
    },
  },

  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },
  exports: { a2a: "a2a" },
}
