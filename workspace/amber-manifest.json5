// AgentBeats registration manifest for LucidCoder
// See: https://docs.agentbeats.dev/manifest/
{
  manifest_version: "0.1.0",

  metadata: {
    name: "LucidCoder",
    description: "Self-disciplined coding agent for Terminal-Bench 2.0. Decompose -> plan (with checker) -> execute (with retry + anti-paralysis guard) -> verify (test run + anti-pattern grep + artifact check). Speaks terminal-bench-shell-v1 over A2A.",
  },

  // Auth: Vertex AI Express mode — single API key, optional rotation slots.
  // Backed by Vertex (per-project quota & billing) but with the Gemini-Developer
  // UX (no SA JSON, no ADC). Confirmed in google-genai SDK
  // (Client(vertexai=True, api_key=...)).
  config_schema: {
    type: "object",
    properties: {
      google_api_key: {
        type: "string",
        secret: true,
        description: "Vertex AI Express API key (primary)",
      },
      google_api_key_2: {
        type: "string",
        secret: true,
        description: "Backup Vertex Express API key 2",
      },
      google_api_key_3: {
        type: "string",
        secret: true,
        description: "Backup Vertex Express API key 3",
      },
      google_api_key_4: {
        type: "string",
        secret: true,
        description: "Backup Vertex Express API key 4",
      },
      google_api_key_5: {
        type: "string",
        secret: true,
        description: "Backup Vertex Express API key 5",
      },
    },
    required: ["google_api_key"],
    additionalProperties: false,
  },

  // Required for AgentBeats router to wire A2A traffic into this container.
  // Both the canonical agent-template and the terminal-bench-green declare
  // this slot — without it, the gateway gets `error=client error (Connect)`
  // when trying to reach the purple's loopback :9009.
  slots: {
    proxy: { kind: "a2a", optional: true },
  },

  program: {
    image: "ghcr.io/mdadopoulos/lucidcoder:latest",
    entrypoint: ["python", "-m", "src.server"],
    env: {
      // Required secret
      GOOGLE_API_KEY: "${config.google_api_key}",

      // Optional rotation keys — wrap each in `{ when, value }` so the env
      // var is OMITTED when the user didn't fill that slot. Without `when`,
      // Amber raises `manifest::optional_env_config` at validation and
      // `interpolation error: config.X not found` at runtime.
      GOOGLE_API_KEY_2: {
        when:  "config.google_api_key_2",
        value: "${config.google_api_key_2}",
      },
      GOOGLE_API_KEY_3: {
        when:  "config.google_api_key_3",
        value: "${config.google_api_key_3}",
      },
      GOOGLE_API_KEY_4: {
        when:  "config.google_api_key_4",
        value: "${config.google_api_key_4}",
      },
      GOOGLE_API_KEY_5: {
        when:  "config.google_api_key_5",
        value: "${config.google_api_key_5}",
      },

      // Static
      MODEL_ID:  "gemini-3.1-pro-preview",
      LOG_LEVEL: "INFO",
    },
    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9009 },
      ],
    },
  },

  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },
  exports: { a2a: "a2a" },
}
