# Vertex AI auth — required
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Path to a service-account JSON with the "Vertex AI User" role.
# Locally: also OK to leave this unset and run `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/your/sa.json

# Static
MODEL_ID=gemini-3.1-pro-preview
SERVER_PORT=9009
SERVER_HOST=0.0.0.0
LOG_LEVEL=INFO
